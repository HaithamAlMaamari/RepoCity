{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-city",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "limits": {
    "cpu_ms": 10000,
    "subrequests": 1000
  }
}
