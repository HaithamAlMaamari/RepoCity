{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-city",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request, not just /api/*. With the previous ["/api/*"] the asset
    // server answered HTML and bundles directly and the Worker never ran for
    // them, so the security headers it attaches -- including the CSP -- never
    // reached the page they exist to protect. The Worker now wraps asset
    // responses too, which keeps one definition of those headers.
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "INGEST_GLOBAL_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "INGEST_ACTOR_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 10000,
    "subrequests": 1000
  }
}
