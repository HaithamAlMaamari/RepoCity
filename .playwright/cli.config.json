{
  "browser": {
    "isolated": true,
    "launchOptions": {
      "headless": false
    },
    "contextOptions": {
      "serviceWorkers": "block"
    }
  },
  "network": {
    "allowedOrigins": [
      "http://127.0.0.1:5173",
      "ws://127.0.0.1:5173",
      "http://localhost:5173",
      "ws://localhost:5173",
      "https://fonts.googleapis.com",
      "https://fonts.gstatic.com"
    ]
  },
  "outputDir": ".playwright-cli",
  "outputMode": "file",
  "allowUnrestrictedFileAccess": false,
  "codegen": "none",
  "console": {
    "level": "warning"
  }
}
