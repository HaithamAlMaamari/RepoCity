{
  "name": "repo-city",
  "private": true,
  "version": "1.0.0",
  "description": "Explore any public GitHub repository as an interactive 3D city — files become buildings, directories become districts, languages set the skyline's colors.",
  "author": "Haitham Al Maamari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaithamAlMaamari/RepoCity.git"
  },
  "homepage": "https://github.com/HaithamAlMaamari/RepoCity#readme",
  "bugs": {
    "url": "https://github.com/HaithamAlMaamari/RepoCity/issues"
  },
  "keywords": [
    "github",
    "visualization",
    "threejs",
    "webgl",
    "3d",
    "code-city",
    "cloudflare-workers",
    "data-visualization"
  ],
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "prelint": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html}\"",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc --noEmit",
    "pretypecheck:worker": "wrangler types",
    "typecheck:worker": "tsc --project worker/tsconfig.json",
    "test": "npm run test:unit && npm run test:worker-runtime",
    "test:unit": "vitest run --exclude worker/**/*.workerd.test.ts",
    "pretest:worker-runtime": "vite build",
    "test:worker-runtime": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --exclude worker/**/*.workerd.test.ts",
    "build": "npm run typecheck && vite build",
    "check": "npm run lint && npm run test && npm run build",
    "ci": "npm run check && npm run audit && wrangler deploy --dry-run",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview",
    "capture": "node scripts/capture-cities.mjs",
    "worker:types": "wrangler types",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.171.0",
    "concurrently": "10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
